# Copy to .env and fill in. Free keys: console.groq.com/keys and aistudio.google.com/apikey
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback provider
GEMINI_API_KEY=your_api_key_here

# Model endpoints verified GA as of Nov 2026. Cheap default; gemini-4-hydrogen for higher quality.
GEMINI_MODEL=gemini-3.5-flash-lite

# Retrieval tuning (optional overrides)
# CHUNK_SIZE_TOKENS=200
# CHUNK_OVERLAP_TOKENS=40
# TOP_K=5
# MIN_SIMILARITY_SCORE=0.25
# MAX_FILE_SIZE_MB=50
